#!/bin/bash

# omarchy:summary=Run the Omarchy screensaver with theme-aware ambient backdrop

STATE_DIR="$HOME/.local/state/omarchy"

screensaver_in_focus() {
  hyprctl activewindow -j | jq -e '.class == "org.omarchy.screensaver"' >/dev/null 2>&1
}

exit_screensaver() {
  # Avoid recursion
  trap - EXIT SIGINT SIGTERM SIGHUP SIGQUIT

  # Restore cursor visibility
  hyprctl eval 'hl.config({ cursor = { invisible = false } })' &>/dev/null || hyprctl keyword cursor:invisible false &>/dev/null || true

  # Restore previous workspace with instantaneous transition (disable workspace animation only for this switch)
  if [[ -f "$STATE_DIR/screensaver_prev_ws" ]]; then
    PREV_WS=$(cat "$STATE_DIR/screensaver_prev_ws" 2>/dev/null)
    rm -f "$STATE_DIR/screensaver_prev_ws"
    if [[ -n "$PREV_WS" ]]; then
      hyprctl eval 'hl.animation({ leaf = "workspaces", enabled = false })' >/dev/null 2>&1
      hyprctl dispatch "hl.dsp.focus({ workspace = \"$PREV_WS\" })" >/dev/null 2>&1 || hyprctl dispatch workspace "$PREV_WS" >/dev/null 2>&1 || true
      hyprctl eval 'hl.animation({ leaf = "workspaces", enabled = true, speed = 3.2, style = "slide" })' >/dev/null 2>&1
    fi
  fi

  # Restore previous desktop wallpaper
  if [[ -f "$STATE_DIR/screensaver_prev_bg" ]]; then
    PREV_BG=$(cat "$STATE_DIR/screensaver_prev_bg" 2>/dev/null)
    rm -f "$STATE_DIR/screensaver_prev_bg"
    if [[ -n "$PREV_BG" && -f "$PREV_BG" ]]; then
      omarchy-shell -q background setInstant "$PREV_BG"
    fi
  fi

  # Restore the status bar
  rm -f "$STATE_DIR/screensaver_hid_bar"
  rm -f "$STATE_DIR/toggles/bar-off"
  omarchy-shell -q omarchy.bar syncHidden 2>/dev/null || true

  # Kill animation and all screensaver instances
  pkill -x ttfx 2>/dev/null || true
  pkill -f '[o]rg.omarchy.screensaver' 2>/dev/null || true
  exit 0
}

# Trap exit signals and guarantee cleanup on any exit
trap exit_screensaver EXIT SIGINT SIGTERM SIGHUP SIGQUIT

# Ensure cursor visibility is normal
hyprctl eval 'hl.config({ cursor = { invisible = false } })' &>/dev/null || hyprctl keyword cursor:invisible false &>/dev/null || true

tty=$(tty 2>/dev/null)

wait_for_terminal_resize() {
  local deadline=$((SECONDS + 2))
  while ((SECONDS < deadline)) && [[ $(stty size 2>/dev/null) == "24 80" ]]; do
    sleep 0.02
  done
}

wait_for_terminal_resize

BRANDING_FILE="$HOME/.config/omarchy/branding/screensaver.txt"
if [[ ! -f "$BRANDING_FILE" ]]; then
  BRANDING_FILE="/usr/share/omarchy/branding/screensaver.txt"
fi

# Hide the bar during screensaver
mkdir -p "$STATE_DIR/toggles"
touch "$STATE_DIR/toggles/bar-off"
touch "$STATE_DIR/screensaver_hid_bar"
omarchy-shell -q omarchy.bar syncHidden 2>/dev/null || true

# Sakurazuki ambient color spectrum
HIGHLIGHT_COL="f0dceb"
GRAD_1="d9a6c4"
GRAD_2="a87692"
GRAD_3="443043"
ACCENT_ALT="c2aedf"
TEXT_ALT="f0dceb"

EFFECTS=(
  beams binarypath blackhole bouncyballs bubbles burn colorshift crumble
  decrypt errorcorrect expand fireworks highlight laseretch matrix middleout
  orbittingvolley overflow pour print rain randomsequence rings scattered
  slice slide smoke spotlights spray swarm sweep synthgrid thunderstorm
  unstable vhstape waves wipe
)

while true; do
  EFFECT="${1:-${EFFECTS[RANDOM % ${#EFFECTS[@]}]}}"

  case "$EFFECT" in
    matrix)
      ttfx -i "$BRANDING_FILE" \
        --frame-rate 120 --canvas-width 0 --canvas-height 0 --reuse-canvas --anchor-canvas c --anchor-text c \
        --no-eol --no-restore-cursor \
        matrix \
        --highlight-color "$HIGHLIGHT_COL" \
        --rain-color-gradient "$GRAD_1" "$GRAD_2" "$GRAD_3" \
        --final-gradient-stops "$GRAD_1" "$GRAD_2" &
      ;;
    rain)
      ttfx -i "$BRANDING_FILE" \
        --frame-rate 120 --canvas-width 0 --canvas-height 0 --reuse-canvas --anchor-canvas c --anchor-text c \
        --no-eol --no-restore-cursor \
        rain \
        --rain-colors "$GRAD_1" "$GRAD_2" "$ACCENT_ALT" "$TEXT_ALT" \
        --final-gradient-stops "$GRAD_1" "$GRAD_2" &
      ;;
    decrypt)
      ttfx -i "$BRANDING_FILE" \
        --frame-rate 120 --canvas-width 0 --canvas-height 0 --reuse-canvas --anchor-canvas c --anchor-text c \
        --no-eol --no-restore-cursor \
        decrypt \
        --ciphertext-colors "$GRAD_1" "$GRAD_2" "$ACCENT_ALT" \
        --final-gradient-stops "$GRAD_1" "$GRAD_2" &
      ;;
    *)
      ttfx -i "$BRANDING_FILE" \
        --frame-rate 120 --canvas-width 0 --canvas-height 0 --reuse-canvas --anchor-canvas c --anchor-text c \
        --no-eol --no-restore-cursor \
        "$EFFECT" &
      ;;
  esac

  while pgrep -t "${tty#/dev/}" -x ttfx >/dev/null; do
    # Only dismiss when Enter is pressed
    if IFS= read -r -s -d '' -n 1 -t 0.1 char; then
      if [[ "$char" == $'\n' || "$char" == $'\r' ]]; then
        exit_screensaver
      fi
    fi

    # Exit if window lost focus
    if ! screensaver_in_focus; then
      exit_screensaver
    fi
  done
done
