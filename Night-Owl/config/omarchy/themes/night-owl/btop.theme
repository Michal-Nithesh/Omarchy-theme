# Night Owl btop theme
# Main background
theme[main_bg]="#011627"

# Main text color
theme[main_fg]="#D6DEEB"

# Title color for boxes
theme[title]="#D6DEEB"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#7FDBCA"

# Background color of selected item in processes box
theme[selected_bg]="#1D3B53"

# Foreground color of selected item in processes box
theme[selected_fg]="#7FDBCA"

# Color of inactive/disabled text
theme[inactive_fg]="#637777"

# Color of text appearing on top of graphs
theme[graph_text]="#E2E8F0"

# Background color of the percentage meters
theme[meter_bg]="#1D3B53"

# Misc colors for processes box
theme[proc_misc]="#E2E8F0"

# Box outline colors
theme[cpu_box]="#C792EA"
theme[mem_box]="#ADDB67"
theme[net_box]="#FF6363"
theme[proc_box]="#7FDBCA"

# Box divider line
theme[div_line]="#1D3B53"

# Temperature graph color (Green -> Yellow -> Red)
theme[temp_start]="#ADDB67"
theme[temp_mid]="#ECC48D"
theme[temp_end]="#FF6363"

# CPU graph colors (Teal -> Blue -> Magenta)
theme[cpu_start]="#7FDBCA"
theme[cpu_mid]="#82AAFF"
theme[cpu_end]="#C792EA"

# Mem/Disk free meter
theme[free_start]="#C792EA"
theme[free_mid]="#82AAFF"
theme[free_end]="#7FDBCA"

# Mem/Disk cached meter
theme[cached_start]="#82AAFF"
theme[cached_mid]="#7FDBCA"
theme[cached_end]="#C792EA"

# Mem/Disk available meter
theme[available_start]="#ADDB67"
theme[available_mid]="#7FDBCA"
theme[available_end]="#82AAFF"

# Mem/Disk used meter
theme[used_start]="#7FDBCA"
theme[used_mid]="#ECC48D"
theme[used_end]="#FF6363"

# Download graph colors
theme[download_start]="#82AAFF"
theme[download_mid]="#7FDBCA"
theme[download_end]="#ADDB67"

# Upload graph colors
theme[upload_start]="#C792EA"
theme[upload_mid]="#82AAFF"
theme[upload_end]="#FF6363"

# Process box color gradient
theme[process_start]="#7FDBCA"
theme[process_mid]="#82AAFF"
theme[process_end]="#C792EA"
